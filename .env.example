# Copy this file to .env and fill in your values.
# Your Z.AI (Zhipu) API key — get it from https://open.bigmodel.cn
ZAI_API_KEY=your_z_ai_key_here

# Model to use. Alternatives: glm-4.6 (best quality, ~2.5s), glm-4.5-flash, GLM-4.7-Flash (reasoning, slow)
# Recommended: glm-4.5-air (fast + cheap). Pair with thinking:disabled in answer.mjs.
ZAI_MODEL=glm-4.5-air

# Z.AI OpenAI-compatible endpoint. Leave as-is unless they change it.
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
